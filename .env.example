# Runtime mode: public builds must use backend mode.
PATHOS_DATA_MODE=backend

# Relative to frontend/ when commands are run from that directory.
PATHOS_PREVIEW_BUNDLE_DIR=./data/preview
PATHOS_BACKEND_BASE_URL=
PATHOS_BACKEND_TIMEOUT_MS=10000
NEXT_PUBLIC_PATHOS_API_BASE_URL=/api/pathos/preview

# MapLibre is the no-key default. Baidu is optional and requires your own AK.
NEXT_PUBLIC_PATHOS_MAP_PROVIDER=maplibre
NEXT_PUBLIC_BAIDU_MAP_AK=replace_with_your_own_key

# Optional external AI provider. Leave blank for deterministic local Demo analysis.
AI_PROVIDER=local
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
