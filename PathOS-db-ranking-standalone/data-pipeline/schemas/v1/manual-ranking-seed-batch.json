{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/manual-ranking-seed-batch.json",
  "title": "PathOS manually verified ranking seed batch",
  "type": "object",
  "required": ["record_type", "schema_version", "batch_id", "created_at", "records"],
  "properties": {
    "record_type": {"const": "manual_ranking_seed_batch"},
    "schema_version": {"const": "v1"},
    "batch_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object", "properties": {"edition_evidence": {"enum": ["edition_direct", "edition_inferred_from_release_cycle", "edition_ambiguous"]}, "evidence_anchors": {"type": "array", "items": {"type": "object", "required": ["field", "source_id", "quote", "evidence_type"], "properties": {"field": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}, "evidence_type": {"const": "direct_quote"}}}}}}}
  }
}
