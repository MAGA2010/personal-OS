{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/ranking-scope.json",
  "title": "PathOS ranking scope configuration",
  "type": "object",
  "required": ["schema_version", "scope_name", "selection_rules", "categories", "universe_status"],
  "properties": {
    "schema_version": {"const": "v1"},
    "scope_name": {"type": "string", "minLength": 1},
    "selection_rules": {"type": "object"},
    "categories": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "universe_status": {"type": "string", "enum": ["not_collected", "incomplete", "complete"]}
  }
}
