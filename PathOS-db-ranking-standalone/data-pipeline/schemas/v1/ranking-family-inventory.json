{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/ranking-family-inventory.json",
  "title": "PathOS ranking family inventory",
  "type": "object",
  "required": ["record_type", "schema_version", "inventory_id", "discovery_date", "families"],
  "properties": {
    "record_type": {"const": "ranking_family_inventory"},
    "schema_version": {"const": "v1"},
    "inventory_id": {"type": "string", "minLength": 1},
    "discovery_date": {"type": "string", "minLength": 1},
    "families": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
