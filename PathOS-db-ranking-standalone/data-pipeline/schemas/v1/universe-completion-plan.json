{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.local/schemas/v1/universe-completion-plan.json",
  "title": "PathOS Universe Completion Plan",
  "type": "object",
  "required": ["record_type", "edition", "baseline", "phases", "output_boundaries"],
  "properties": {
    "record_type": {"const": "universe_completion_plan"},
    "edition": {"type": "string", "minLength": 1},
    "baseline": {"type": "object"},
    "phases": {"type": "array", "minItems": 3},
    "output_boundaries": {"type": "object"}
  },
  "additionalProperties": true
}
