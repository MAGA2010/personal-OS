{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/canonical-university.json",
  "title": "PathOS canonical-compatible university record",
  "type": "object",
  "required": ["record_type", "is_test_fixture", "university", "sources", "university_sources", "selection_memberships", "frontend_fields"],
  "properties": {
    "record_type": {"const": "canonical_university"},
    "is_test_fixture": {"type": "boolean"},
    "university": {"type": "object"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "university_sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "selection_memberships": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "frontend_fields": {"type": "object"}
  }
}
