  "keyDecisions": [
    {
      "topic": "safety normalization direction",
      "decision": "preserve rawValue as raw crime rate; recompute normalizedValue as 1 - workbook_norm",
      "rationale": "metadata description '倒数' misleading; raw is real crime rate, not reciprocal. Inverting norm ensures low crime → high score → darker color = 'safer' visually."
    },
    {
      "topic": "regional data vs match scores",
      "decision": "usedForMatch = false for all 4 ready metrics",
      "rationale": "state-level macro data does not linearly predict school-level micro experience. Region data is environmental context only."
    },
    {
      "topic": "deterministic importer",
      "decision": "Python script with sorted keys + trailing newline; verified two runs produce byte-identical output",
      "rationale": "enables provenance SHA verification; reproducibility is part of acceptance gate"
    },
    {
      "topic": "4 separate palettes instead of one",
      "decision": "income=green, safety=blue, employment=purple, chinese=orange, each with light+dark stops",
      "rationale": "color-coded metrics are easier to distinguish in legend; no shared stops prevents visual confusion when multiple metrics visible"
    }
  ],
