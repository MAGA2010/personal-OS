# Explicit data mode. Production permits backend only.
PATHOS_DATA_MODE=backend

# Stage 5 uses a deterministic local Preview Bundle through the Next.js BFF.
PATHOS_PREVIEW_BUNDLE_DIR=./data/preview

# Reserved for the alternative HTTP transport. Not used by the Stage 5 bundle mode.
PATHOS_BACKEND_BASE_URL=
PATHOS_BACKEND_TIMEOUT_MS=8000

# Browser-facing requests stay on the same-origin BFF.
NEXT_PUBLIC_PATHOS_API_BASE_URL=/api/pathos/preview

# Stage 7B-A — Map Provider selection.
# Allowed values: "maplibre" (default) | "baidu"
# - "maplibre": the existing MapLibre raster basemap (CARTO Voyager /
#   Dark Matter). Always available, no external key required.
# - "baidu": loads the Baidu Map JSAPI GL when an AK is configured.
#   The host falls back to MapLibre if the AK is missing or invalid;
#   the request only succeeds after the user has added the current
#   domain (e.g. http://localhost:3002) to the Referer whitelist in
#   the Baidu Map console.
NEXT_PUBLIC_PATHOS_MAP_PROVIDER=maplibre

# Stage 7B-A — Baidu Map JSAPI AK. Required only when the provider
# flag above is "baidu". Leave blank to keep MapLibre as the active
# provider. Do NOT commit a real value; this is a placeholder.
NEXT_PUBLIC_BAIDU_MAP_AK=


# --- Supabase Postgres (Render Web Service backend) ---
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
PATHOS_DB_POOL_MAX=10

