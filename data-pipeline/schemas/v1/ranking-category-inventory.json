{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/ranking-category-inventory.json",
  "title": "PathOS versioned undergraduate ranking category inventory",
  "type": "object",
  "required": ["record_type", "schema_version", "inventory_id", "inventory_version", "ranking_system", "ranking_family", "edition", "publication_date", "discovery_date", "categories"],
  "properties": {
    "record_type": {"const": "ranking_category_inventory"},
    "schema_version": {"const": "v1"},
    "inventory_id": {"type": "string", "minLength": 1},
    "inventory_version": {"type": "string", "minLength": 1},
    "ranking_system": {"const": "u_s_news"},
    "ranking_family": {"const": "undergraduate_program"},
    "edition": {"type": "string", "minLength": 1},
    "publication_date": {"type": "string", "minLength": 1},
    "discovery_date": {"type": "string", "minLength": 1},
    "categories": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
