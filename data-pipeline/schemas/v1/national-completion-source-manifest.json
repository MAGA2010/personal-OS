{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/national-completion-source-manifest.json",
  "title": "PathOS National completion manual seed source manifest",
  "type": "object",
  "required": ["record_type", "edition", "accessed_at", "sources"],
  "properties": {
    "record_type": {"const": "national_completion_source_manifest"},
    "edition": {"const": "2026 Best Colleges"},
    "accessed_at": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 2, "items": {"type": "object"}}
  }
}
