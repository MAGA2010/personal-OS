{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.local/schemas/v1/stage3d-fill-bulk-people-v2-slot.json",
  "title": "Stage 3D-Fill Bulk People v2 Top-1 Program Person Slot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "canonical_id",
    "university_name",
    "slot_index",
    "program_name",
    "normalized_program_name",
    "program_source_reference",
    "slot_status",
    "person_id",
    "person_name",
    "person_identity_disambiguator_source_id",
    "identity_resolution_method",
    "identity_confirmation_notes",
    "relationship_type",
    "match_type",
    "program_match_basis",
    "match_notes",
    "source_ids",
    "source_url",
    "evidence_anchor",
    "quote_verification_method",
    "reviewed_scope",
    "reviewed_source_ids",
    "null_reason"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "canonical_id": {"type": "string", "minLength": 1},
    "university_name": {"type": "string", "minLength": 1},
    "slot_index": {"type": "integer", "const": 1},
    "program_name": {"type": "string", "minLength": 1},
    "normalized_program_name": {"type": "string", "minLength": 1},
    "program_source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_basis", "source_id", "source_record_id", "evidence_anchor"],
      "properties": {
        "source_basis": {"type": "string", "minLength": 1},
        "source_id": {"type": ["string", "null"]},
        "source_record_id": {"type": ["string", "null"]},
        "evidence_anchor": {"type": ["object", "null"]}
      }
    },
    "slot_status": {
      "type": "string",
      "enum": ["identified_person", "source_review_not_completed", "no_qualifying_person_found"]
    },
    "person_id": {"type": ["string", "null"]},
    "person_name": {"type": ["string", "null"]},
    "person_identity_disambiguator_source_id": {"type": ["string", "null"]},
    "identity_resolution_method": {"type": ["string", "null"]},
    "identity_confirmation_notes": {"type": ["string", "null"]},
    "relationship_type": {
      "type": ["string", "null"],
      "enum": ["graduated", "alumnus_unspecified", "attended_no_degree", null]
    },
    "match_type": {
      "type": ["string", "null"],
      "enum": ["direct_program_match", "direct_related_program_match", null]
    },
    "program_match_basis": {"type": ["string", "null"]},
    "match_notes": {"type": ["string", "null"]},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "source_url": {"type": ["string", "null"]},
    "evidence_anchor": {"type": ["object", "null"]},
    "quote_verification_method": {
      "type": ["string", "null"],
      "enum": ["local_cache_substring_check", null]
    },
    "reviewed_scope": {"type": "array", "items": {"type": "string"}},
    "reviewed_source_ids": {"type": "array", "items": {"type": "string"}},
    "null_reason": {"type": ["string", "null"]}
  }
}
