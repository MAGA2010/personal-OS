{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/national-manual-seed-input.json",
  "title": "PathOS National Top-50 user-provided manual seed input",
  "type": "object",
  "required": ["record_type", "imported_at", "source_document", "entries"],
  "properties": {
    "record_type": {"const": "national_manual_seed_input"},
    "imported_at": {"type": "string", "minLength": 1},
    "source_document": {
      "type": "object",
      "required": ["title", "publisher", "source_file"],
      "properties": {
        "title": {"const": "Top 100 College Ranking Shifts 2026 vs. 2025"},
        "publisher": {"const": "Think Academy"},
        "source_file": {"type": "string", "minLength": 1}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 56,
      "items": {
        "type": "object",
        "required": ["institution", "rank_2026", "rank_2025", "change", "source_page"],
        "properties": {
          "institution": {"type": "string", "minLength": 1},
          "rank_2026": {"type": "integer", "minimum": 1},
          "rank_2025": {"type": "integer", "minimum": 1},
          "change": {"type": "string", "minLength": 1},
          "source_page": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
