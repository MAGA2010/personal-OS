{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/raw-university.json",
  "title": "PathOS raw university record",
  "type": "object",
  "required": ["record_type", "is_test_fixture", "university", "source", "frontend_fields"],
  "properties": {
    "record_type": {"const": "university_raw"},
    "is_test_fixture": {"type": "boolean"},
    "university": {"$ref": "university-core.json"},
    "source": {"$ref": "source.json"},
    "frontend_fields": {"$ref": "frontend-fields.json"}
  }
}
