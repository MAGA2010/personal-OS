{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/frontend-fields.json",
  "title": "PathOS frontend adapter fields",
  "type": "object",
  "required": ["rankingBand", "rankingTier", "annualCostRmb", "safetyScore", "recognitionScore", "chineseCommunity", "directFlight", "postStudyVisa", "programs", "parentHighlights", "studentHighlights", "nearby"],
  "properties": {
    "rankingBand": {"type": "string", "minLength": 1},
    "rankingTier": {"type": "string", "enum": ["top20", "top50", "top100", "other"]},
    "annualCostRmb": {"type": "number", "minimum": 0},
    "safetyScore": {"type": "number", "minimum": 0, "maximum": 100},
    "recognitionScore": {"type": "number", "minimum": 0, "maximum": 100},
    "chineseCommunity": {"type": "string", "enum": ["low", "medium", "high"]},
    "directFlight": {"type": "boolean"},
    "postStudyVisa": {"type": "string"},
    "programs": {"type": "array", "items": {"type": "string"}},
    "parentHighlights": {"type": "array", "items": {"type": "string"}},
    "studentHighlights": {"type": "array", "items": {"type": "string"}},
    "nearby": {"type": "object", "required": ["subwayStations", "chineseRestaurants", "asianGroceries", "avgRentRmb"]}
  }
}
