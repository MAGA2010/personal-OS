{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathos.example/schemas/v1/staging-university.json",
  "title": "PathOS staging university record",
  "type": "object",
  "required": ["record_type", "staging_status", "is_test_fixture", "university", "source", "frontend_fields"],
  "properties": {
    "record_type": {"const": "university_staging"},
    "staging_status": {"const": "ready_for_normalization"},
    "is_test_fixture": {"type": "boolean"},
    "university": {"type": "object"},
    "source": {"type": "object"},
    "frontend_fields": {"type": "object"}
  }
}
